<?xml version="1.0" encoding="utf-8"?>
<!-- Both layers are 432x432 px PNGs covering the full 108dp canvas (4 px/dp). The bulb is 48dp tall,
     centred horizontally and sits 1dp below the centre so it looks optically centred. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@drawable/ic_keep_foreground" />
    <monochrome android:drawable="@drawable/ic_keep_monochrome" />
</adaptive-icon>
